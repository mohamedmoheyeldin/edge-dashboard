<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EdgeDashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edge Dashboard">
    <!-- The layout is designed at 2560x720; the Viewbox scales it to whatever the display reports. -->
    <Grid x:Name="Backdrop">
        <Viewbox Stretch="Uniform">
            <!-- Page 1: the dashboard. Page 2 (swipe left): screen settings. -->
            <FlipView x:Name="Pages" Width="2560" Height="720" Background="Transparent">
                <Grid x:Name="Root" />
                <Grid x:Name="DisplayHost" />
            </FlipView>
        </Viewbox>
    </Grid>
</Window>
